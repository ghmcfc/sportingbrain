---
// How-to-play guide shown under a game: real, page-specific text plus FAQ structured data.
interface Props { title: string; intro: string[]; faq: [string, string][]; links?: [string, string][]; irish?: boolean }
const { title, intro, faq, links = [], irish = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<section class:list={['guide', { 'guide-ie': irish }]} aria-labelledby="guideH">
  <h2 id="guideH">{title}</h2>
  {intro.map(p => <p>{p}</p>)}
  <h3>Questions people ask</h3>
  <dl>{faq.map(([q, a]) => <><dt>{q}</dt><dd>{a}</dd></>)}</dl>
  {links.length > 0 && <p class="guide-more">More to play: {links.map(([h, t], i) => <>{i > 0 && ' · '}<a href={base + h}>{t}</a></>)}</p>}
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
<style>
  .guide{max-width:780px;margin:36px auto 8px;padding:22px 22px 18px;background:var(--card,#fff);border:1px solid var(--line,#dfe3ea);border-top:4px solid #0F1E36;border-radius:4px}
  .guide-ie{border-top-color:#0B6E3B}
  .guide h2{margin:0 0 10px;font-size:1.5rem}
  .guide h3{margin:20px 0 8px;font-size:1.15rem}
  .guide p{margin:0 0 10px;line-height:1.6}
  .guide dt{font-weight:700;margin-top:12px}
  .guide dd{margin:4px 0 0;line-height:1.6}
  .guide-more{margin-top:18px;font-size:.95rem}
</style>
