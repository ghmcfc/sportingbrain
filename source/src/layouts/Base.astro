---
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/source-serif-4/opsz';
import '@fontsource-variable/source-serif-4/opsz-italic';
import '../styles/global.css';
import '../styles/editorial.css';
interface Props { title: string; description: string; page?: string; wide?: boolean; image?: string; type?: string; noindex?: boolean; }
const { title, description, page = '', wide = false, image, type = 'website', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image || 'https://images.pexels.com/photos/1657324/pexels-photo-1657324.jpeg?auto=compress&cs=tinysrgb&w=1200';
const nav = [
  ['Play', `${base}play.html`],
  ['Call It', `${base}call-it.html`],
  ['This Week', `${base}this-week.html`],
  ['Flashback', `${base}flashback.html`],
  ['On This Day', `${base}on-this-day.html`],
  ['Guides', `${base}sports.html`],
  ['Ask the Brain', `${base}ask.html`],
  ['Round-Up', `${base}round-up.html`],
  ['Kids', `${base}kids.html`],
  ['Newsletter', `${base}newsletter.html`],
];
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'SportingBrain', url: new URL(base, Astro.site).href, description: 'The free daily sports hub for everyone who loves sport.' };
---
<!DOCTYPE html>
<html lang="en-GB" data-base={base}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex,nofollow">}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#14254a">
<link rel="icon" href={`${base}assets/mark.svg`} type="image/svg+xml">
<link rel="preconnect" href="https://images.pexels.com">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top"><div class="wrap">
  <a class="wordmark" href={base} aria-label="SportingBrain home"><span class="mark" aria-hidden="true">SB</span><span>SportingBrain</span></a>
  <nav class="mainnav" aria-label="Main">{nav.map(([t, h]) => <a href={h}>{t}</a>)}</nav>
  <div class="hdr-right">
    <button class="iconbtn" data-share-site aria-label="Share SportingBrain">Share</button>
    <button class="iconbtn" data-dark aria-label="Switch dark mode">Dark</button>
    <button class="iconbtn menu-btn" aria-expanded="false" aria-controls="mnav" id="menubtn">Menu</button>
  </div>
</div>
<nav class="mobilenav" id="mnav" aria-label="Menu">{nav.map(([t, h]) => <a href={h}>{t}</a>)}<a href={`${base}about.html`}>About and privacy</a></nav>
</header>
<div class="datebar"><div class="wrap"><span id="today-date"></span><span>Free to play. No betting, ever.</span></div></div>
<script>document.addEventListener('click',e=>{const a=e.target.closest('[data-mistake]');if(a)a.href='https://tally.so/r/zE7LVZ?page='+encodeURIComponent(location.pathname+location.search);});</script>
<main class:list={['wrap', { wide }]} data-page={page} id="main"><slot /></main>
<footer class="site-foot"><div class="wrap wide foot-grid">
  <div><a class="wordmark" href={base}><span class="mark" aria-hidden="true">SB</span><span>SportingBrain</span></a>
    <p>The smartest free sports site in the world. Real matches, real data, stories nobody else tells. No betting, ever.</p></div>
  <div><h3>Play</h3><a href={`${base}play.html`}>All games</a><a href={`${base}pub-quiz.html`}>Pub and Club Quiz</a><a href={`${base}weekly-expert.html`}>Weekly Expert</a><a href={`${base}call-it.html`}>Call It</a><a href={`${base}daily.html`}>Beat the Brain</a><a href={`${base}higher-or-lower.html`}>Higher or Lower</a><a href={`${base}the-grid.html`}>The Grid</a><a href={`${base}challenge.html?c=family`}>Family challenge</a><a href={`${base}kids.html`}>Kids Zone</a></div>
  <div><h3>Read</h3><a href={`${base}this-week.html`}>This Week in Sport</a><a href={`${base}flashback.html`}>Flashback</a><a href={`${base}on-this-day.html`}>On This Day</a><a href={`${base}replays.html`}>Replays</a><a href={`${base}sports.html`}>Sport guides</a><a href={`${base}round-up.html`}>The Cynical Round-Up</a></div>
  <div><h3>SportingBrain</h3><a href={`${base}newsletter.html`}>The Daily Brain newsletter</a><a href={`${base}about.html`}>About and privacy</a><a href="#" data-welcome>What is SportingBrain?</a><a href="#" data-dys>Dyslexia-friendly font</a><a href="https://tally.so/r/zE7LVZ" data-mistake target="_blank" rel="noopener">Spotted a mistake? Tell us</a></div>
</div><div class="wrap wide foot-small"><p>Photos from Pexels. Cricket data from Cricsheet (Open Data Commons Attribution License). Facts checked against the sources listed on every article.</p></div></footer>
<script>
  import '../scripts/app.js';
  const b = document.getElementById('menubtn'), m = document.getElementById('mnav');
  b?.addEventListener('click', () => { const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
</script>
</body>
</html>
