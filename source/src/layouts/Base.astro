---
import '../styles/global.css';
interface Props { title: string; description: string; page?: string; wide?: boolean; image?: string; type?: string; noindex?: boolean; }
const { title, description, page = '', wide = false, image, type = 'website', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = image || 'https://images.pexels.com/photos/1657324/pexels-photo-1657324.jpeg?auto=compress&cs=tinysrgb&w=1200';
const nav = [
  ['Play', `${base}#games`],
  ["Flashback", `${base}flashback.html`],
  ["Replays", `${base}replays.html`],
  ['Family', `${base}challenge.html?c=family`],
  ['Round-Up', `${base}round-up.html`],
  ['Sport A to Z', `${base}sports.html`],
  ['Newsletter', `${base}#newsletter`],
];
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'SportingBrain', url: new URL(base, Astro.site).href, description: 'The free daily sports hub for everyone who loves sport.' };
---
<!DOCTYPE html>
<html lang="en-GB" data-base={base}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex,nofollow">}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#14254a">
<link rel="icon" href={`${base}assets/brain.svg`} type="image/svg+xml">
<link rel="preconnect" href="https://images.pexels.com">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top"><div class="wrap">
  <a href={base}><img src={`${base}assets/brain.svg`} alt="SportingBrain home" width="40" height="40"></a>
  <a class="logo" href={base}>Sporting<span>Brain</span></a>
  <nav class="mainnav" aria-label="Main">{nav.map(([t, h]) => <a href={h}>{t}</a>)}</nav>
  <div class="hdr-right">
    <button class="iconbtn" data-share-site aria-label="Share SportingBrain">Share</button>
    <button class="iconbtn" data-dark aria-label="Switch dark mode">🌙</button>
    <button class="iconbtn menu-btn" aria-expanded="false" aria-controls="mnav" id="menubtn">Menu</button>
  </div>
</div>
<nav class="mobilenav" id="mnav" aria-label="Menu">{nav.map(([t, h]) => <a href={h}>{t}</a>)}<a href={`${base}about.html`}>About and privacy</a></nav>
</header>
<div class="datebar"><div class="wrap"><span id="today-date"></span><span>Every fan. Every sport. Every day.</span></div></div>
<main class:list={['wrap', { wide }]} data-page={page} id="main"><slot /></main>
<footer class="wrap">
  <p>SportingBrain is free, for every fan, every sport and every age. No betting, ever.</p>
  <p><a href={base}>Home</a> · <a href={`${base}#who`}>Who we are</a> · <a href={`${base}#newsletter`}>Newsletter</a> · <a href={`${base}about.html`}>About and privacy</a> · <a href="#" data-dys>Dyslexia-friendly font</a> · <a href="#" data-welcome>What is SportingBrain?</a></p>
  <p class="small">Sport photos from Pexels. The Brain is our own creation.</p>
</footer>
<script>
  import '../scripts/app.js';
  const b = document.getElementById('menubtn'), m = document.getElementById('mnav');
  b?.addEventListener('click', () => { const o = m.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
</script>
</body>
</html>
