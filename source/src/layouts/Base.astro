---
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/source-serif-4/opsz';
import '@fontsource-variable/source-serif-4/opsz-italic';
import '../styles/global.css';
import '../styles/editorial.css';
import fBS900 from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2?url';
import fBS800 from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-800-normal.woff2?url';
import fSS from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-opsz-normal.woff2?url';
interface Props { title: string; description: string; page?: string; wide?: boolean; image?: string; type?: string; noindex?: boolean; noads?: boolean; }
const { title, description, page = '', wide = false, image, type = 'website', noindex = false, noads = false } = Astro.props;
import ADS from '../data/ads.json';
import AN from '../data/analytics.json';
import { amz, picksFor } from '../data/shop.js';
import { SEO } from '../data/seo.js';
import { SHARE } from '../data/sharetext.js';
import { PLAY as PLAYLIST } from '../data/playlist.js';
import UkBand from '../components/UkBand.astro';
const adsOn = !!ADS.client && !noads && !/^\/kids/.test(Astro.url.pathname);
// Game pages: no ads while people play. AdSense loads once a game is finished (markPlayed calls SB_loadAds).
const isGamePage = PLAYLIST.some(x => '/' + x[0] === Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '')) || /^\/(daily|ireland\/(brain|county|legends|quiz)|pick-a-sport)/.test(Astro.url.pathname);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const pathKey = '/' + Astro.url.pathname.replace(/^\//, '').replace(base.replace(/^\//, ''), '');
const S = SEO[pathKey] || SEO[pathKey + '.html'] || {};
// Titles over 60 characters get cut off in search results: drop the section, then the brand, before that happens.
let pageTitle = S.title || title;
if (pageTitle.length > 60) pageTitle = pageTitle.replace(' | Flashback | SportingBrain', ' | SportingBrain');
if (pageTitle.length > 60) pageTitle = pageTitle.replace(/ \| SportingBrain( Kids Zone)?$/, '');
let pageDesc = S.description || description || '';
if (pageDesc.length > 160) { pageDesc = pageDesc.slice(0, 157).replace(/[\s,;:.]+\S*$/, '') + '…'; }
const shareItem = SHARE[pathKey.replace(/^\//, '').replace(/\.html$/, '')];
const canonical = new URL(/\/index(\.html)?$/.test(Astro.url.pathname) ? base : Astro.url.pathname, Astro.site).href;
const crumbs = (() => { const parts = pathKey.replace(/\.html$/, '').split('/').filter(Boolean); if (parts.length < 2) return null;
  const SEC = { flashback: ['Flashback', 'flashback.html'], stories: ['True stories', 'stories.html'], replays: ['Replays', 'replays.html'], sports: ['Sport guides', 'sports.html'], kids: ['Kids Zone', 'kids.html'], ireland: ['SportingBrain Ireland', 'ireland.html'] };
  const sec = SEC[parts[0]]; if (!sec) return null;
  return { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'SportingBrain', item: new URL(base, Astro.site).href },
    { '@type': 'ListItem', position: 2, name: sec[0], item: new URL(base + sec[1], Astro.site).href },
    { '@type': 'ListItem', position: 3, name: pageTitle.replace(/ \|.*$/, ''), item: canonical } ] }; })();
const ogImage = image || new URL(base + 'og.png', Astro.site).href;
const nav = [
  ['Brain', base, 'today'],
  ['Ireland', `${base}ireland.html`, 'ireland'],
  ['Shop', `${base}gift-guide.html`, 'shop'],
  ['More', `${base}more.html`, 'more'],
];
const path = Astro.url.pathname.replace(base, '/').replace(/\.html$/, '');
const section = /^\/kids/.test(path) ? 'kids' : /^\/ireland/.test(path) ? 'ireland' : /^\/gift-guide/.test(path) ? 'shop'
  : (path === '/' || path === '/index' || /^\/(daily|who-am-i|ground-guesser|pick-a-sport)/.test(path)) ? 'today' : /^\/(about|credits|settings|offline)/.test(path) ? '' : 'more';
const isKids = /^\/kids/.test(path);
const ukCur = (path === '/' || path === '/index') ? 'hub' : path === '/daily' ? 'brain' : path === '/who-am-i' ? 'whoami' : path === '/ground-guesser' ? 'grounds' : path === '/pick-a-sport' ? 'sports' : '';
const giftPicks = (!noads && !isKids) ? picksFor(path) : null;
const slotPage = path === '/' || /^\/(index|daily)(\.html)?$/.test(path);
const nlBar = !isKids && !noads && /^\/(flashback\/|stories|on-this-day|round-up|gift-guide|sports\/|read)/.test(path);
const showNl = !isKids && !noads && (!!shareItem || path === '/' || /^\/(index|read|this-week|flashback|on-this-day|round-up|tiktok)(\.html)?$/.test(path)) && !/^\/newsletter/.test(path);
const SOCIAL = [['X','https://x.com/_sportingbrain'],['Instagram','https://www.instagram.com/_sportingbrain/'],['TikTok','https://www.tiktok.com/@_sportingbrain']];
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'SportingBrain', url: new URL(base, Astro.site).href, description: 'The free daily sports hub for everyone who loves sport.' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'SportingBrain', url: new URL(base, Astro.site).href, logo: new URL(base + 'assets/icon-512.png', Astro.site).href, sameAs: SOCIAL.map(x => x[1]) }];
---
<!DOCTYPE html>
<html lang="en-GB" data-base={base}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{pageTitle}</title>
<meta name="description" content={pageDesc}>
{noindex && <meta name="robots" content="noindex,nofollow">}
<link rel="canonical" href={canonical}>
<meta property="og:type" content={type}>
<meta property="og:site_name" content="SportingBrain">
<meta property="og:locale" content="en_GB">
<meta property="og:title" content={pageTitle.replace(/ \| SportingBrain$/, '')}>
<meta property="og:description" content={pageDesc}>
<meta property="og:image:alt" content={pageTitle.replace(/ \| SportingBrain$/, '')}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@_sportingbrain">
<meta name="theme-color" content="#0F1E36">
<link rel="preload" href={fBS900} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fBS800} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fSS} as="font" type="font/woff2" crossorigin>
<link rel="manifest" href={`${base}manifest.webmanifest`}>
<link rel="apple-touch-icon" href={`${base}assets/apple-touch-icon.png`}>
<link rel="icon" href={`${base}assets/mark.svg`} type="image/svg+xml">
<script type="application/ld+json" set:html={JSON.stringify(crumbs ? [...ld, crumbs] : ld)} />
{adsOn && !isGamePage && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS.client}`} crossorigin="anonymous"></script>}
{adsOn && isGamePage && <script is:inline define:vars={{ adClient: ADS.client }}>window.SB_loadAds=function(){if(window.__sbAds)return;window.__sbAds=1;var s=document.createElement('script');s.async=true;s.crossOrigin='anonymous';s.src='https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client='+adClient;document.head.appendChild(s);};</script>}
{adsOn && <script is:inline>window.SB_ADS=true;document.addEventListener('DOMContentLoaded',()=>setTimeout(()=>document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])').forEach(()=>{try{(window.adsbygoogle=window.adsbygoogle||[]).push({})}catch(e){}}),50));</script>}
{AN.goatcounter && !noads && <script is:inline data-goatcounter={`https://${AN.goatcounter}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
<script is:inline>(function(){var Q=[];window.sbTrack=function(n){if(window.goatcounter&&window.goatcounter.count){window.goatcounter.count({path:'event/'+n,title:n,event:true});}else{Q.push(n);}};
var t=setInterval(function(){if(window.goatcounter&&window.goatcounter.count){clearInterval(t);Q.splice(0).forEach(sbTrack);}},700);setTimeout(function(){clearInterval(t)},15000);
var sa=matchMedia('(display-mode: standalone)').matches||navigator.standalone===true;if(sa){document.documentElement.classList.add('is-app');try{if(!sessionStorage.getItem('sb_appopen')){sessionStorage.setItem('sb_appopen','1');sbTrack('app-open');}}catch(e){}}
addEventListener('appinstalled',function(){sbTrack('app-installed');});
document.addEventListener('click',function(e){var a=e.target.closest('a,button');if(!a)return;var n=a.getAttribute('data-track');if(n){sbTrack(n);return;}
var h=a.getAttribute('href')||'';if(/amazon\.co\.uk/.test(h)){sbTrack('amazon-click'+location.pathname.replace(/\.html$/,'').replace(/\//g,'-'));return;}
var q=a.getAttribute('data-sq');if(q){sbTrack('share-'+q+location.pathname.replace(/\.html$/,'').replace(/\//g,'-'));return;}
if(a.hasAttribute('data-share-page')||a.hasAttribute('data-share-site')){sbTrack('share-header');}},true);})();</script>
<script is:inline>(function(){var H=document.documentElement,B=H.dataset.base||'/',dp=null,K='sb_appx',T=function(n){window.sbTrack&&sbTrack(n)};
var ua=navigator.userAgent,ios=/iPhone|iPad|iPod/.test(ua)||(/Macintosh/.test(ua)&&navigator.maxTouchPoints>1),sa=H.classList.contains('is-app');
function kids(){return !!document.querySelector('.kz')||/\/kids/.test(location.pathname)}
function off(){try{return Date.now()<(+localStorage.getItem(K)||0)||localStorage.getItem('sb_appdone')==='1'}catch(e){return false}}
function snooze(d){try{localStorage.setItem(K,String(Date.now()+d*864e5))}catch(e){}}
function can(){return !sa&&!kids()&&!off()&&(dp||ios)}
function done(){try{localStorage.setItem('sb_appdone','1')}catch(e){}document.querySelectorAll('.appc,.appbar').forEach(function(x){x.remove()})}
function go(src){T('app-click-'+src);if(dp){var p=dp;dp=null;p.prompt();p.userChoice.then(function(r){T('app-'+r.outcome+'-'+src);if(r.outcome==='accepted')done();}).catch(function(){});return true;}if(ios){showIos();return true;}return false;}
function showIos(){var c=document.querySelector('.appc');if(c){c.querySelector('.appc-ios').hidden=false;var gb=c.querySelector('[data-app-go]');if(gb)gb.hidden=true;c.scrollIntoView({block:'center',behavior:'smooth'});return;}location.href=B+'app.html';}
var IOS='<p class="appc-ios" hidden>In Safari, tap the <b>Share</b> button <span aria-hidden="true">(the square with the arrow)</span>, scroll down and tap <b>Add to Home Screen</b>. Done.</p>';
function card(){return '<div class="appc" role="region" aria-label="Get the app"><img src="'+B+'assets/icon-192.png" alt="" width="52" height="52"><div class="appc-tx"><b>Tomorrow\'s games, one tap away</b><p>Put SportingBrain on your home screen. Free, no sign-up, nothing to download.</p>'+IOS+'<div class="appc-btns"><button type="button" class="btn gold" data-app-go="after-game">'+(dp?'Add it to my home screen':'Show me how')+'</button><button type="button" class="linkbtn" data-app-x>Not now</button></div></div></div>';}
function fill(){if(!can())return;document.querySelectorAll('[data-app-card]').forEach(function(h){if(h.firstChild||document.querySelector('.appc'))return;h.innerHTML=card();T('app-card-shown');});}
function bar(){if(!can()||document.getElementById('appBar')||/\/app(\.html)?$/.test(location.pathname))return;var days=[];try{days=JSON.parse(localStorage.getItem('sb_days')||'[]');if(sessionStorage.getItem('sb_appbar'))return;}catch(e){}if(days.length<2)return;
var n=0,t=setTimeout(show,20000);function act(){if(++n>=3){clearTimeout(t);show();}}addEventListener('scroll',act,{passive:true});addEventListener('click',act);
function show(){removeEventListener('scroll',act);removeEventListener('click',act);if(!can()||document.querySelector('.appc')||document.querySelector('.welcome:not([hidden])'))return;try{sessionStorage.setItem('sb_appbar','1')}catch(e){}
var d=document.createElement('div');d.id='appBar';d.className='appbar';d.setAttribute('role','region');d.setAttribute('aria-label','Get the app');d.innerHTML='<img src="'+B+'assets/icon-192.png" alt="" width="36" height="36"><span><b>SportingBrain on your home screen</b><small>Free. One tap to today\'s games.</small></span><button type="button" class="btn gold" data-app-go="bar">'+(dp?'Add it':'Show me')+'</button><button type="button" class="appbar-x" data-app-x aria-label="Close">×</button>';document.body.appendChild(d);T('app-bar-shown');}}
try{var dk=new Date().toISOString().slice(0,10),ds=JSON.parse(localStorage.getItem('sb_days')||'[]');if(ds[ds.length-1]!==dk){ds.push(dk);localStorage.setItem('sb_days',JSON.stringify(ds.slice(-10)));}}catch(e){}
addEventListener('beforeinstallprompt',function(e){e.preventDefault();dp=e;H.classList.add('can-install');fill();bar();});
addEventListener('appinstalled',done);
document.addEventListener('click',function(e){var g=e.target.closest('[data-app-go],[data-app-install]');if(g){if(go(g.dataset.appGo||g.dataset.appInstall))e.preventDefault();if(g.dataset.appGo==='bar'&&ios){var b=document.getElementById('appBar');b&&b.remove();location.href=B+'app.html';}return;}
var x=e.target.closest('[data-app-x]');if(x){snooze(30);T('app-dismiss');(x.closest('.appc')||x.closest('.appbar')).remove();}});
new MutationObserver(function(){if(document.querySelector('[data-app-card]:empty'))fill();}).observe(document.body||H,{childList:true,subtree:true});
if(ios){document.addEventListener('DOMContentLoaded',function(){fill();bar();});}})();</script>
<script is:inline>if('serviceWorker' in navigator&&location.protocol==='https:')addEventListener('load',()=>navigator.serviceWorker.register(document.documentElement.dataset.base+'sw.js').catch(()=>{}));</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top"><div class="wrap">
  <a class="wordmark" href={base}><span class="mark" aria-hidden="true">SB</span><span>SportingBrain</span></a>
  <nav class="sb-tabs" aria-label="Main">{nav.filter(([, , k]) => !(k === 'gifts' && (isKids || noads))).map(([t, h, k]) => <a href={h} class={k === 'gifts' ? 'tab-gifts' : undefined} aria-current={section === k ? "page" : undefined}>{t}</a>)}</nav>
  <div class="hdr-right">
    {shareItem ? <button class="iconbtn hdr-share" data-share-page aria-label="Share this page">Share</button> : <button class="iconbtn hdr-share" data-share-site aria-label="Share SportingBrain">Share</button>}
    {!isKids && <a class="iconbtn hdr-app" href={`${base}app.html`} data-app-install="header">App</a>}{!isKids && <a class="iconbtn hdr-team" href={`${base}colours.html`} aria-label="Pick your team" data-track="colours-header"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><defs><clipPath id="ycShirt"><path d="M8 3l-5 3 2 4 2-1v12h10V9l2 1 2-4-5-3c-.6 1.6-2.2 2.6-4 2.6S8.6 4.6 8 3z"/></clipPath></defs><g clip-path="url(#ycShirt)" id="ycShirtFill"><rect width="24" height="24" fill="none"/></g><path d="M8 3l-5 3 2 4 2-1v12h10V9l2 1 2-4-5-3c-.6 1.6-2.2 2.6-4 2.6S8.6 4.6 8 3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><span class="hdr-team-t">Team</span></a>}<button class="iconbtn hdr-dark" data-dark aria-label="Switch dark mode">Dark</button>
  </div>
</div>

</header>
{!isKids && <div id="ycStrip" class="yc-strip" hidden></div>}
{!isKids && <script is:inline>(function(){try{var c=JSON.parse(localStorage.getItem('sb_colours')||'null'),ie=/\/ireland(\/|\.html|$)/.test(location.pathname),k=c?(ie?(c.colmap&&(c.picks&&c.picks.ie?c.colmap.ie:c.colmap.gaa))||[]:c.cols||[]):[],s=document.getElementById('ycStrip');if(!s||!k.length)return;s.style.background='linear-gradient(90deg,'+k.map(function(h,i){return h+' '+(i*100/k.length)+'% '+((i+1)*100/k.length)+'%'}).join(',')+')';s.hidden=false;var g=document.getElementById('ycShirtFill');if(g){g.innerHTML=k.map(function(h,i){return '<rect x="'+(i*24/k.length)+'" y="0" width="'+(24/k.length+.2)+'" height="24" fill="'+h+'"/>'}).join('');var b=g.closest('a');b.classList.add('has-team');var nm=ie?(c.picks&&(c.picks.ie||c.picks.gaa)):(c.picks&&c.picks[c.badge]);b.setAttribute('aria-label','Your team: '+(nm||'')+'. Change it');if(ie)b.href=(document.documentElement.dataset.base||'/')+'ireland.html#ieCounty';}}catch(e){}})();</script>}
<script>document.addEventListener('click',e=>{const a=e.target.closest('[data-mistake]');if(a)a.href='https://tally.so/r/zE7LVZ?page='+encodeURIComponent(location.pathname+location.search);});</script>
{shareItem && <div class:list={["wrap sq-top sq-btns", { wide }]} data-sq-title={shareItem[0]} data-sq-text={`${shareItem[0]} on SportingBrain. ${shareItem[1]} Free to play.`} data-sq-url={canonical}>
  <span class="sq-top-l">{/gift-guide/.test(path) ? 'Share this guide' : 'Share this game'}</span>
  <a class="sqt wa" data-sq="whatsapp" target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2s.2-1.1.1-1.2l-.4-.2z"/></svg><span>WhatsApp</span></a>
  <a class="sqt" data-sq="x" target="_blank" rel="noopener" aria-label="Share on X"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg><span class="vh">X</span></a>
  <a class="sqt" data-sq="facebook" target="_blank" rel="noopener" aria-label="Share on Facebook"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M14 8V6.3c0-.8.2-1.3 1.4-1.3H17V2h-2.6C11.3 2 10 3.7 10 6.2V8H8v3h2v11h4V11h2.7l.4-3H14z"/></svg><span class="vh">Facebook</span></a>
  <a class="sqt" data-sq="email" aria-label="Share by email"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.3-8-5.3zM5.6 7l6.4 4.2L18.4 7H5.6z"/></svg><span>Email</span></a>
  <button type="button" class="sqt" data-sq="copy">Copy link</button>
  <button type="button" class="sqt nat" data-sq="native" hidden>More</button>
</div>}
{ukCur && <div class:list={["wrap uk-band-wrap", { wide }]}><UkBand current={ukCur} /></div>}
<main class:list={['wrap', { wide, jsdraw: !!(S.h1 && page), 'is-game': PLAYLIST.some(x => '/' + x[0] === path.replace(/\.html$/, '')) }]} data-page={page} id="main">{S.h1 && page && <div class="crawl"><h1>{S.h1}</h1>{S.intro && <p class="teaser">{S.intro}</p>}</div>}<slot /></main>
{showNl && !slotPage && <aside class:list={["wrap nl-box", { wide }]} aria-labelledby="nlb-h">
  <div class="nlb-copy"><h2 id="nlb-h">The Weekly Brain</h2><p>{/^\/ireland/.test(path) ? "Every Friday: the week's five hardest questions plus an Irish section, with the Irish question of the week and the Irish sports book. Free." : "The week's five hardest questions, the best Call It moment and a forgotten story. Every Friday. Free."}</p></div>
  <form class="nlb-form" data-nl novalidate>
    <label class="vh" for="nlb-e">Email address</label>
    <input id="nlb-e" type="email" name="EMAIL" autocomplete="email" placeholder="Your email address" required>
    <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" class="vh" aria-hidden="true">
    <button type="submit" class="btn gold">Send me the Weekly Brain</button>
    <p class="nlb-msg" role="status"></p>
  </form>
  <p class="nlb-small">We'll email a link to confirm. Unsubscribe in one click. 13 or over only. <a href={`${base}about.html`}>Privacy</a></p>
</aside>}
{showNl && slotPage && <template id="nl-tpl"><aside class="nl-box in-slot" aria-label="The Weekly Brain newsletter">
  <div class="nlb-copy"><h2 >The Weekly Brain</h2><p>{/^\/ireland/.test(path) ? "Every Friday: the week's five hardest questions plus an Irish section, with the Irish question of the week and the Irish sports book. Free." : "The week's five hardest questions, the best Call It moment and a forgotten story. Every Friday. Free."}</p></div>
  <form class="nlb-form" data-nl novalidate>
    <label class="vh" >Email address</label>
    <input  type="email" name="EMAIL" autocomplete="email" placeholder="Your email address" required>
    <input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" class="vh" aria-hidden="true">
    <button type="submit" class="btn gold">Send me the Weekly Brain</button>
    <p class="nlb-msg" role="status"></p>
  </form>
  <p class="nlb-small">We'll email a link to confirm. Unsubscribe in one click. 13 or over only. <a href={`${base}about.html`}>Privacy</a></p>
</aside></template>}
{shareItem && <section class="wrap share-quiz" aria-labelledby="sq-h">
  <h2 id="sq-h">{/^\/gift-guide/.test(path) ? "Share this guide" : "Share this quiz"}</h2>
  <p class="sq-what"><b>{/[?!]$/.test(shareItem[0]) ? shareItem[0] : shareItem[0] + "."}</b> {shareItem[1]}</p>
  <div class="sq-btns" data-sq-title={shareItem[0]} data-sq-text={`${shareItem[0]} on SportingBrain. ${shareItem[1]} Free to play.`} data-sq-url={canonical}>
    <button type="button" class="btn" data-sq="native">Share</button>
    <a class="btn ghost" data-sq="whatsapp" target="_blank" rel="noopener">WhatsApp</a>
    <a class="btn ghost" data-sq="x" target="_blank" rel="noopener">X</a>
