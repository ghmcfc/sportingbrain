---
import Base from '../layouts/Base.astro';
import { PLAY, GROUPS } from '../data/playlist.js';
import { icon } from '../scripts/icons.js';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const href = s => s === 'challenge' ? `${base}challenge.html?c=family` : `${base}${s}.html`;
---
<Base title="Play: every SportingBrain game, quiz and puzzle | SportingBrain" description="Call It, Beat the Brain, the Pub and Club Quiz, Stat Attack, Is It a Foul?, Matchday Bingo, Legends XI and more. Free, no betting, no sign-up." page="play" wide>
  <header class="pg-head"><h1>Play</h1><p>{PLAY.length} games, quizzes and puzzles. All free, all built on real sport, men's and women's. Nothing to sign up for and no betting, ever.</p></header>
  {GROUPS.map(([g, label]) => (
    <section class="blk">
      <header class="sh"><h2>{label}</h2></header>
      <div class="gtiles">{PLAY.filter(p => p[3] === g).map(p => (
        <a class="gt" href={href(p[0])} style={`--c:${p[4]}`} data-slug={p[0]}><span class="gt-ic" set:html={icon(p[0], 44)} /><span class="gt-tx"><b>{p[1]}</b><small>{p[2]}</small><small data-st></small></span></a>
      ))}</div>
    </section>
  ))}
  <section class="blk"><header class="sh"><h2>For children</h2></header>
    <div class="gtiles"><a class="gt" href={`${base}kids.html`} style="--c:#0B6E4F"><span class="gt-ic" set:html={icon('kids', 44)} /><span class="gt-tx"><b>Kids Zone</b><small>Quizzes and games for ages 6 to 12. No ads, no chat, no sign-up.</small></span></a></div>
  </section>
  <section class="pg-card"><h2>Put a SportingBrain puzzle on your site</h2><p>Clubs, schools and blogs can embed today's question for free. Copy this and paste it into your page.</p>
    <pre class="pg-code" id="embedCode"></pre><button class="btn ghost" id="copyEmbed">Copy the code</button></section>
  <script>
    import { store, BASE, SITE, toast } from '../scripts/play.js';
    const p = store.get('pg_played', {});
    document.querySelectorAll('[data-slug]').forEach(a => { const n = p[a.dataset.slug]; if (n) a.querySelector('[data-st]').textContent = `You've played ${n} time${n > 1 ? 's' : ''}`; });
    const code = `<iframe src="${SITE}embed.html" title="SportingBrain question of the day" width="100%" height="380" style="border:0;max-width:520px" loading="lazy"></iframe>`;
    document.getElementById('embedCode').textContent = code;
    document.getElementById('copyEmbed').onclick = () => navigator.clipboard.writeText(code).then(() => toast('Copied. Paste it into your page.'), () => prompt('Copy this:', code));
  </script>
</Base>
