---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { SB_GROUPS } from '../data/sportgroups.js';
import { ALL } from '../data/bank_all.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const count = g => ALL.filter(q => g[3].includes(q[1]) && q[0] >= 2).length;
---
<Base title="Pick a Sport: ten-question sports quizzes | SportingBrain" description="Ten-question quizzes on the sport you know best: football, cricket, rugby, tennis, golf, F1, athletics and more. A fresh set every time. Free, no sign-up." page="pickasport">
  <header class="pg-head"><h1>Pick a Sport</h1><p>Ten questions on the sport you know best, Medium to Expert, a fresh set every time. Play as often as you like. Today's Beat the Brain questions are kept out, so nothing gets spoiled.</p></header>
  <div id="vs"></div>
  <div class="ps-groups" id="groups">
    {SB_GROUPS.map(g => <a href={`${base}pick-a-sport.html?s=${g[0]}`}><b>{g[1]}</b><span>{g[2]}</span><small>{count(g)} questions</small></a>)}
    <a href={`${base}ireland/quiz.html`} class="ps-ie"><b>Irish sport</b><span>GAA, Irish rugby, the League of Ireland and more</span><small>On SportingBrain Ireland</small></a>
  </div>
  <section class="pg-card" id="pq" aria-live="polite" hidden></section>
  <AdSlot name="game_result" />
  <script>
    import { SB_GROUPS } from '../data/sportgroups.js';
    import { ALL } from '../data/bank_all.js';
    import { btbTexts, btbDay } from '../scripts/qsched.js';
    import { shuffle, esc, markPlayed, challengeBox, showChallenge, share, store, ukDayNo } from '../scripts/play.js';
    showChallenge(document.getElementById('vs'));
    const s = new URLSearchParams(location.search).get('s'), G = SB_GROUPS.find(g => g[0] === s), box = document.getElementById('pq');
    if (G) {
      document.getElementById('groups').hidden = true; box.hidden = false;
      const d = btbDay(ukDayNo()), busy = btbTexts(ALL, d, d), seenKey = 'ps_seen_' + G[0], seen = new Set(store.get(seenKey, []));
      const pool = ALL.filter(q => G[3].includes(q[1]) && q[0] >= 2 && !busy.has(q[2]));
      const QS = shuffle(pool.filter(q => !seen.has(q[2]))).concat(shuffle(pool.filter(q => seen.has(q[2])))).slice(0, Math.min(10, pool.length));
      store.set(seenKey, [...seen, ...QS.map(q => q[2])].slice(-Math.max(0, pool.length - 10)));
      const LV = ['', 'Easy', 'Medium', 'Hard', 'Expert'], OPTS = QS.map(x => shuffle(x[3].map((t, j) => [t, j === x[4]])));
      let i = 0; const ans = [];
      const pips = () => `<div class="ie-pips">${QS.map((_, k) => `<i class="${k < ans.length ? (ans[k] ? 'ok' : 'no') : k === i ? 'cur' : ''}"></i>`).join('')}</div>`;
      function q() { const x = QS[i];
        box.innerHTML = `<p class="pg-step">${esc(G[1])} · Question ${i + 1} of ${QS.length} · ${LV[x[0]]}</p>${pips()}<p class="pg-q">${esc(x[2])}</p><div class="pg-opts">${OPTS[i].map((o, k) => `<button data-k="${k}">${esc(o[0])}</button>`).join('')}</div><div id="after"></div>`; }
      box.addEventListener('click', e => { const b = e.target.closest('.pg-opts button'); if (!b || b.disabled) return;
        const ok = OPTS[i][+b.dataset.k][1]; ans.push(ok); box.querySelectorAll('.pg-opts button').forEach((z, k) => { z.disabled = true; if (OPTS[i][k][1]) z.classList.add('ok'); }); if (!ok) b.classList.add('no');
        box.querySelector('#after').innerHTML = `<p class="pg-fact"><b>${ok ? 'Right.' : 'No. It was ' + esc(QS[i][3][QS[i][4]]) + '.'}</b> ${esc(QS[i][5] || '')}</p><div class="pg-btns"><button class="btn gold" id="nx">${i < QS.length - 1 ? 'Next question' : 'See your score'}</button></div>`;
        box.querySelector('#nx').onclick = () => { if (i < QS.length - 1) { i++; q(); } else end(); box.scrollIntoView({ block: 'start', behavior: 'smooth' }); }; });
      function end() { const sc = ans.filter(Boolean).length, grid = ans.map(a => a ? '🟩' : '🟥').join(''); markPlayed('pick-a-sport');
        box.innerHTML = `<p class="pg-step">${esc(G[1])} quiz</p><p class="pg-score">${sc}/${QS.length}</p><p style="font-size:1.6rem;letter-spacing:.1em;margin:6px 0">${grid}</p>
          <div class="pg-btns"><button class="btn gold" id="shr">Share my score</button><a class="btn ghost" href="?s=${G[0]}">New ${esc(G[1])} quiz</a><a class="btn ghost" href="pick-a-sport.html">Pick another sport</a></div>`;
        box.querySelector('#shr').onclick = () => share(`SportingBrain Pick a Sport · ${G[1]}\n${grid} ${sc}/${QS.length}`, location.href);
        box.appendChild(challengeBox(sc, QS.length, `${G[1]} quiz`)); }
      q();
    }
  </script>
</Base>
