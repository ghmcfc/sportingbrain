---
import Base from '../layouts/Base.astro';
import AdSlot from '../components/AdSlot.astro';
import { buildMoments } from '../data/callit.js';
import { PLAY, GROUPS } from '../data/playlist.js';
import { FLASHBACKS } from '../data/flashbacks.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const M = buildMoments().map(m => ({ match: m.match, team: m.team, opp: m.opp, score: m.score, at: m.at, need: m.need, q: m.qs[0].q, innings: m.innings }));
---
<Base title="SportingBrain: the smartest free sports site in the world" description="Call It, the daily game built on real matches. Flashback, On This Day, ball-by-ball replays, proper sport guides and the Cynical Round-Up. Free. No betting, ever." page="home" wide>
  <script is:inline>(function(){try{var d=new Date(new Date().toLocaleString('en-US',{timeZone:'Europe/London'})).getDay();var f=['329300362865','03839c401997','fa48a10aa76d','03722f0fe294','6eec06d35c25','40d56c180e9c','329300362865'][d];var l=document.createElement('link');l.rel='preload';l.as='image';l.setAttribute('fetchpriority','high');l.href=(document.documentElement.dataset.base||'/')+'photos/hook/'+f+'.jpg';document.head.appendChild(l);}catch(e){}})();</script>
  <div class="crawl">
    <h1>Free daily sports quizzes, games and stories</h1>
    <p class="teaser">SportingBrain is a free sports site for people who know their sport. Daily games built on real matches, hard quiz questions, and true stories from every sport, men's and women's. No sign-up, no betting, ever.</p>
    {GROUPS.map(([g, label]) => <section><h2>{label}</h2><ul>{PLAY.filter(x => x[3] === g).map(x => <li><a href={`${base}${x[0]}.html`}>{x[1]}</a>: {x[2]}</li>)}</ul></section>)}
    <section><h2>Read</h2><ul>
      <li><a href={`${base}this-week.html`}>This Week's Quiz</a>: five questions on the past week in sport, with the stories behind them.</li>
      <li><a href={`${base}on-this-day.html`}>On This Day</a>: what happened in sport on today's date.</li>
      <li><a href={`${base}stories.html`}>True sports stories</a>: comebacks, firsts, underdogs and heroes.</li>
      <li><a href={`${base}sports.html`}>Sport guides</a>: how every sport really works.</li>
      {FLASHBACKS.slice(0, 6).map(f => <li><a href={`${base}flashback/${f.id}.html`}>{f.title}</a>: {f.standfirst}</li>)}
    </ul></section>
  </div>
  <noscript><p>SportingBrain needs JavaScript switched on to play the games.</p></noscript>
  <template id="ad-home_leaderboard"><AdSlot name="home_leaderboard" /></template>
  <template id="ad-home_infeed"><AdSlot name="home_infeed" /></template>
  <script id="ciHome" type="application/json" set:html={JSON.stringify(M)} />
</Base>
