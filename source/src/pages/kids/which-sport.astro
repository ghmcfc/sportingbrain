---
import Kids from '../../layouts/Kids.astro';
---
<Kids title="Which Sport Are You? | SportingBrain Kids Zone" description="Six quick questions to find the sport that matches your personality." band="older">
  <header class="pg-head"><h1>Which Sport Are You?</h1><p>Six questions, no right answers. At the end you find out which sport suits you best.</p></header>
  <section class="pg-card" id="game" aria-live="polite"></section>
  <script>
    import { PERSONALITY } from '../../data/games.js';
    import { esc, share, markPlayed, BASE } from '../../scripts/play.js';
    const g = document.getElementById('game'); let i = 0, tally = {};
    function show() { const [q, opts] = PERSONALITY.qs[i];
      g.innerHTML = `<p class="pg-step">${i + 1} of ${PERSONALITY.qs.length}</p><p class="pg-q">${esc(q)}</p><div class="pg-opts">${opts.map(o => `<button data-s="${o[1]}">${esc(o[0])}</button>`).join('')}</div>`; }
    g.addEventListener('click', e => { const b = e.target.closest('[data-s]'); if (b) { tally[b.dataset.s] = (tally[b.dataset.s] || 0) + 1 + i / 100; i++; if (i < PERSONALITY.qs.length) show(); else end(); }
      if (e.target.closest('[data-again]')) { i = 0; tally = {}; show(); } });
    function end() { markPlayed('which-sport'); const s = Object.entries(tally).sort((a, b) => b[1] - a[1])[0][0], line = PERSONALITY.results[s];
      g.innerHTML = `<p class="pg-step">Your sport</p><p class="pg-q" style="font-size:1.5rem">${esc(line)}</p><div class="pg-btns"><button class="btn ghost" id="sh">Share</button><button class="btn ghost" data-again>Try again</button></div>`;
      document.getElementById('sh').onclick = () => share(`SportingBrain says: ${line}`, location.origin + location.pathname); }
    show();
  </script>
</Kids>
