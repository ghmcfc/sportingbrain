---
import Kids from '../../layouts/Kids.astro';
---
<Kids title="Design your own football kit | SportingBrain Kids Zone" description="Pick colours, stripes or hoops and a number, then print your own kit. Saved on your device only." band="kit">
  <section class="kz-hero small"><div><h1>Design your own kit</h1><p>Choose your colours and pattern, add a number, then print it out.</p></div></section>
  <section class="kz-card kit-wrap">
    <svg viewBox="0 0 200 210" role="img" aria-label="Your kit" id="kit">
      <defs><clipPath id="body"><path d="M60 20 L80 10 Q100 24 120 10 L140 20 L190 50 L172 88 L152 78 L152 200 L48 200 L48 78 L28 88 L10 50 Z"/></clipPath></defs>
      <g clip-path="url(#body)"><rect x="0" y="0" width="200" height="210" id="base"/><g id="pat"></g>
        <path d="M10 50 L60 20 L48 78 L28 88 Z" id="sl1"/><path d="M190 50 L140 20 L152 78 L172 88 Z" id="sl2"/></g>
      <path d="M60 20 L80 10 Q100 24 120 10 L140 20 L190 50 L172 88 L152 78 L152 200 L48 200 L48 78 L28 88 L10 50 Z" fill="none" stroke="#0F1E36" stroke-width="3"/>
      <text x="100" y="140" text-anchor="middle" font-family="Big Shoulders Display, sans-serif" font-weight="800" font-size="64" id="num">10</text>
    </svg>
    <form class="pg-form" id="kf" style="grid-template-columns:1fr 1fr">
      <label>Main colour <input type="color" name="a" value="#0B6E4F"></label>
      <label>Second colour <input type="color" name="b" value="#FFFFFF"></label>
      <label>Sleeves <input type="color" name="c" value="#0F1E36"></label>
      <label>Number colour <input type="color" name="n" value="#FFFFFF"></label>
      <label>Pattern <select name="p"><option value="plain">Plain</option><option value="stripes">Stripes</option><option value="hoops">Hoops</option><option value="halves">Halves</option><option value="sash">Sash</option></select></label>
      <label>Number <input name="no" type="number" min="1" max="99" value="10"></label>
      <div class="pg-btns" style="grid-column:1/-1"><button type="button" class="btn gold" onclick="window.print()">Print my kit</button><button type="button" class="btn ghost" id="rnd">Surprise me</button></div>
    </form>
  </section>
  <script>
    import { store } from '../../scripts/play.js';
    const f = document.getElementById('kf'), q = id => document.getElementById(id), s = store.get('kit', null);
    if (s) for (const k in s) if (f[k]) f[k].value = s[k];
    function draw() { const v = Object.fromEntries(new FormData(f)); store.set('kit', v); q('base').setAttribute('fill', v.a); q('sl1').setAttribute('fill', v.c); q('sl2').setAttribute('fill', v.c);
      const n = q('num'); n.textContent = v.no || ''; n.setAttribute('fill', v.n);
      const P = { plain: '', stripes: [30, 70, 110, 150, 190].map(x => `<rect x="${x - 10}" y="0" width="20" height="210" fill="${v.b}"/>`).join(''), hoops: [40, 90, 140, 190].map(y => `<rect x="0" y="${y - 12}" width="200" height="24" fill="${v.b}"/>`).join(''), halves: `<rect x="100" y="0" width="100" height="210" fill="${v.b}"/>`, sash: `<path d="M40 10 L80 10 L190 200 L150 200 Z" fill="${v.b}"/>` };
      q('pat').innerHTML = P[v.p] || ''; }
    f.addEventListener('input', draw);
    q('rnd').onclick = () => { const c = () => '#' + Math.floor(Math.random() * 16777215).toString(16).padStart(6, '0'); f.a.value = c(); f.b.value = c(); f.c.value = c(); f.p.value = ['plain', 'stripes', 'hoops', 'halves', 'sash'][Math.floor(Math.random() * 5)]; draw(); };
    draw();
  </script>
</Kids>
