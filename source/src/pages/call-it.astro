---
import Base from '../layouts/Base.astro';
import { buildMoments } from '../data/callit.js';
const moments = buildMoments();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Call It: the daily sports prediction game built on real matches | SportingBrain" description="We freeze a real moment from a real final. You call what happens next. Then the replay shows you. One a day." page="callit" wide>
  <section class="ci">
    <div class="ci-head"><span class="tag" style="background:var(--gold);color:#14254a">Call It #<span id="ciNum"></span></span>
      <h1>We freeze a real match. You call what happens next.</h1>
      <p class="teaser">A real moment from a real final, stopped mid-match. Make your calls, then watch it play out ball by ball. No spoilers until it's bowled. Even if you saw it live, you won't remember this.</p></div>
    <div class="ci-grid">
      <div class="card ci-board" id="ciBoard"></div>
      <div class="card ci-calls" id="ciCalls"></div>
    </div>
    <div class="card ci-play" id="ciPlay" hidden aria-live="polite"></div>
    <div class="card ci-result" id="ciResult" hidden></div>
    <p class="small">Matches rebuilt from Cricsheet ball-by-ball data (Open Data Commons Attribution License). A new Call It every day at midnight UK time. Want more? <a href={`${base}call-it.html?practice=1`}>Practice mode</a>.</p>
  </section>
  <script id="ciData" type="application/json" set:html={JSON.stringify(moments)} />
  <script>
    import { endNav } from '../scripts/play.js';
    const M = JSON.parse(document.getElementById('ciData').textContent);
    const BASE = document.documentElement.dataset.base || '/';
    const S = { get(k, d) { try { const v = localStorage.getItem('sb_' + k); return v === null ? d : JSON.parse(v); } catch (_) { return d; } }, set(k, v) { try { localStorage.setItem('sb_' + k, JSON.stringify(v)); } catch (_) {} } };
    const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const uk = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/London' }));
    const DAY = Math.floor((Date.UTC(uk.getFullYear(), uk.getMonth(), uk.getDate()) - Date.UTC(2026, 10, 23)) / 86400000) + 1;
    // fixed shuffle so the order isn't match by match
    const order = M.map((_, i) => i).sort((a, b) => ((a * 2654435761) % 997) - ((b * 2654435761) % 997));
    // Direct link to one final: ?final=cwc-2019-final (its latest moment) or ?m=<moment id>. Played as practice, so the daily streak is untouched.
    const qp = new URLSearchParams(location.search), qm = qp.get('m'), qf = qp.get('final');
    let linked = qm ? M.findIndex(x => x.id === qm) : -1;
    if (linked < 0 && qf) M.forEach((x, i) => { if (x.slug === qf) linked = i; });
    const practice = qp.has('practice') || linked >= 0;
    const idx = linked >= 0 ? linked : practice ? Math.floor(Math.random() * M.length) : order[(DAY - 1 + M.length * 10) % M.length];
    const m = M[idx]; document.getElementById('ciNum').textContent = practice ? 'practice' : DAY;
    const key = 'ci_' + DAY, saved = practice ? null : S.get(key, null);
    document.getElementById('ciBoard').innerHTML = `
      <div class="small">${esc(m.match)} · ${esc(new Date(m.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }))}</div>
      <div class="ci-team">${esc(m.team)} <span>${m.innings ? 'second innings' : 'first innings'}, v ${esc(m.opp)}</span></div>
      <div class="ci-score">${esc(m.score)} <small>after ${esc(m.at)} overs</small></div>
      ${m.need ? `<div class="ci-need">${esc(m.need)}</div>` : ''}
      <div class="ci-bat">${m.pair.map(p => `<div><b>${esc(p[0])}</b> ${p[1]}${p === m.pair[0] ? ' <small>on strike</small>' : ''}</div>`).join('')}</div>
      <div id="ciChart"></div>`;
    let picks = saved ? saved.picks : [];
    function renderCalls() {
      document.getElementById('ciCalls').innerHTML = m.qs.map((q, qi) => `<fieldset class="ci-q"><legend>${qi + 1}. ${esc(q.q)}</legend>
        <div class="ci-opts">${q.opts.map((o, oi) => `<button class="ci-opt ${picks[qi] === oi ? 'on' : ''} ${revealed ? (oi === q.a ? 'right' : (picks[qi] === oi ? 'wrong' : '')) : ''}" data-q="${qi}" data-o="${oi}" ${locked ? 'disabled' : ''}>${esc(o)}</button>`).join('')}</div></fieldset>`).join('')
        + (locked ? '' : `<button class="btn gold wide" id="ciLock" ${picks.filter(x => x !== undefined).length < m.qs.length ? 'disabled' : ''}>Lock in my calls</button>`);
    }
    const say = b => { const r = b[3], x = b[5]; if (b[4]) return '<b class="w">WICKET.</b> ' + esc(b[4]);
      if (x === 'w') return 'Wide' + (r > 1 ? ', ' + r + ' runs' : ''); if (x === 'n') return 'No ball' + (r > 1 ? ', ' + r + ' runs' : '');
      return r === 4 ? '<b>FOUR</b>' : r === 6 ? '<b>SIX</b>' : r === 0 ? 'No run' : r + ' run' + (r === 1 ? '' : 's'); };
    const bandOf = l => { let mm; if ((mm = l.match(/^Under (\d+)/))) return [0, +mm[1] - 1]; if ((mm = l.match(/^(\d+) to (\d+)/))) return [+mm[1], +mm[2]]; if ((mm = l.match(/^(\d+) or more/))) return [+mm[1], 1e9]; return [0, 1e9]; };
    const status = (dr, dw, done) => { const rb = bandOf(m.qs[0].opts[picks[0]]), wp = picks[1];
      const r = dr > rb[1] ? false : done ? dr >= rb[0] : null;
      const w = wp < 3 && dw > wp ? false : wp === 3 && dw >= 3 ? true : done ? Math.min(3, dw) === wp : null; return [r, w]; };
    const chip = (v, txt) => `<span class="ci-chip ${v === true ? 'ok' : v === false ? 'no' : ''}">${v === true ? '✅' : v === false ? '❌' : '⏳'} ${txt}</span>`;
    // Run chart: the innings so far, the other side's innings when chasing, then the play-out drawn ball by ball.
    function chartSVG(liveBalls, done) {
      const c = m.chart, sm = innerWidth < 600, W = sm ? 360 : 640, H = sm ? 250 : 260, L = 34, R = 10, T = 14, Bm = 30, ov0 = parseFloat(m.at);
      const live = liveBalls.map((b, k) => [ov0 + (k + 1) * (m.span / Math.max(1, m.play.length)), b[6], b[4]]);
      const ymaxRaw = Math.max(c.target || 0, ...(c.other || []).map(p => p[1]), ...c.upto.map(p => p[1]), ...m.play.map(b => b[6]));
      const ymax = Math.ceil(ymaxRaw * 1.08 / 25) * 25, X = o => L + o / m.overs * (W - L - R), Y = r => H - Bm - r / ymax * (H - T - Bm);
      const line = pts => pts.map((p, i) => (i ? 'L' : 'M') + X(p[0]).toFixed(1) + ' ' + Y(p[1]).toFixed(1)).join(' ');
      const step = m.overs <= 20 ? 5 : 10, grid = [];
      for (let o = 0; o <= m.overs; o += step) grid.push(`<line x1="${X(o)}" y1="${T}" x2="${X(o)}" y2="${H - Bm}" class="g"/><text x="${X(o)}" y="${H - Bm + 16}" text-anchor="middle">${o}</text>`);
      for (let r = 0; r <= ymax; r += ymax / 5) grid.push(`<line x1="${L}" y1="${Y(r)}" x2="${W - R}" y2="${Y(r)}" class="g"/><text x="${L - 6}" y="${Y(r) + 4}" text-anchor="end">${Math.round(r)}</text>`);
      let band = '';
      if (picks[0] !== undefined && locked) { const bb = bandOf(m.qs[0].opts[picks[0]]), hi = Math.min(bb[1], ymax - m.start[0]);
        band = `<rect x="${X(ov0 + m.span) - 6}" y="${Y(m.start[0] + hi)}" width="12" height="${Math.max(2, Y(m.start[0] + bb[0]) - Y(m.start[0] + hi))}" class="band"><title>Your runs call</title></rect>`; }
      const liveLine = live.length ? line([[ov0, m.start[0]], ...live.map(p => [p[0], p[1]])]) : '';
      return `<figure class="ci-chart"><svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Run chart for ${esc(m.team)}${c.other ? ' against ' + esc(c.otherTeam) + '\'s innings' : ''}">
        <g class="axis">${grid.join('')}</g>
        ${c.target ? `<line x1="${L}" y1="${Y(c.target)}" x2="${W - R}" y2="${Y(c.target)}" class="tgt"/><text x="${W - R}" y="${Y(c.target) - 5}" text-anchor="end" class="tl">Target ${c.target}</text>` : ''}
        ${c.other ? `<path d="${line(c.other)}" class="oth"/>` : ''}
        <path d="${line(c.upto)}" class="now"/>
        ${c.wk.map(w => `<circle cx="${X(w[0])}" cy="${Y(w[1])}" r="4" class="wk"/>`).join('')}
        <line x1="${X(ov0)}" y1="${T}" x2="${X(ov0)}" y2="${H - Bm}" class="frz"/><text x="${X(ov0) + 4}" y="${T + 10}" class="tl">Frozen here</text>
        ${band}
        ${liveLine ? `<path d="${liveLine}" class="live"/>` : ''}
        ${live.filter(p => p[2]).map(p => `<circle cx="${X(p[0])}" cy="${Y(p[1])}" r="5" class="wk live-wk"/>`).join('')}
        <text x="${(L + W - R) / 2}" y="${H - 2}" text-anchor="middle">Overs</text>
      </svg><figcaption><span class="k now"></span>${esc(m.team)}${c.other ? ` <span class="k oth"></span>${esc(c.otherTeam)}` : ''} ${locked ? '<span class="k live"></span>Play-out ' : ''}<span class="k wk"></span>Wicket${locked ? ' <span class="k band"></span>Your runs call' : ''}</figcaption></figure>`;
    }
    let timer = null;
    function playOut() {
      const P = document.getElementById('ciPlay'); P.hidden = false; let j = 0; const feed = [];
      const head = `<p class="pg-step">Playing out the next ${m.span} overs, ball by ball</p>`;
      function frame(done) { const b = m.play[Math.max(0, j - 1)], runs = j ? b[6] : m.start[0], wk = j ? b[7] : m.start[1], dr = runs - m.start[0], dw = wk - m.start[1], st = status(dr, dw, done);
        P.innerHTML = head + `<div class="ci-live"><div class="ci-score">${runs}/${wk}</div><div>${esc(m.team)} · <b>${dr}</b> run${dr === 1 ? '' : 's'} and <b>${dw}</b> wicket${dw === 1 ? '' : 's'} since you called it</div></div>
          <div class="ci-chips">${chip(st[0], 'Your runs call: ' + esc(m.qs[0].opts[picks[0]]))}${chip(st[1], 'Your wickets call: ' + esc(m.qs[1].opts[picks[1]]))}</div>
          ${chartSVG(m.play.slice(0, j), done)}
          <ol class="ci-feed">${feed.slice(-8).reverse().map(f => `<li><span>${f[0]}</span>${f[1]}</li>`).join('')}</ol>
          ${done ? '' : '<div class="pg-btns"><button class="btn ghost" id="ciSkip">Skip to the end</button></div>'}`;
        const sk = document.getElementById('ciSkip'); if (sk) sk.onclick = () => { clearInterval(timer); while (j < m.play.length) { const x = m.play[j++]; feed.push([x[0], esc(x[2]) + ' to ' + esc(x[1]) + ': ' + say(x)]); } finish(); }; }
      function finish() { frame(true); if (!practice) S.set(key, { picks, watched: true }); setTimeout(() => { reveal(); document.getElementById('ciResult').scrollIntoView({ behavior: 'smooth', block: 'start' }); }, 700); }
      frame(false);
      timer = setInterval(() => { if (j >= m.play.length) { clearInterval(timer); return finish(); } const x = m.play[j++]; feed.push([x[0], esc(x[2]) + ' to ' + esc(x[1]) + ': ' + say(x)]); frame(false); }, 420);
    }
    function reveal() {
      const last = m.play[m.play.length - 1], dr = (last ? last[6] : m.start[0]) - m.start[0], dw = (last ? last[7] : m.start[1]) - m.start[1];
      const marks = m.qs.map((q, i) => picks[i] === q.a), n = marks.filter(Boolean).length; revealed = true; renderCalls();
      const r = document.getElementById('ciResult'); r.hidden = false;
      r.innerHTML = `<p class="pg-step">Your result</p><div class="ci-verdict">${n === 2 ? 'Called it. Both right.' : n === 1 ? 'One out of two.' : 'Not this time.'} <span>${marks.map(x => x ? '✅' : '❌').join('')}</span></div>
        <table class="ci-table"><thead><tr><th>Call</th><th>You said</th><th>What happened</th><th></th></tr></thead><tbody>
        <tr><td>Runs in ${m.span} overs</td><td>${esc(m.qs[0].opts[picks[0]])}</td><td>${dr} runs</td><td>${marks[0] ? '✅' : '❌'}</td></tr>
        <tr><td>Wickets in ${m.span} overs</td><td>${esc(m.qs[1].opts[picks[1]])}</td><td>${dw}</td><td>${marks[1] ? '✅' : '❌'}</td></tr></tbody></table>
        <p>${esc(m.team)} went from ${esc(m.score)} to ${esc(m.after)}.</p>
        ${chartSVG(m.play, true)}
        ${practice ? '' : `<p class="small">Call It streak: <b>${S.get('ci_streak', 0)}</b> day${S.get('ci_streak', 0) === 1 ? '' : 's'}. A new one at midnight.</p>`}
        <div class="pg-btns"><button class="btn gold" id="ciShare">Share my result</button><a class="btn ghost" href="${BASE}replays/${m.slug}.html?g=${m.g}">Full ball-by-ball replay</a><a class="btn ghost" href="?practice=1">Practice another</a></div>`;
      r.appendChild(endNav());
      document.getElementById('ciShare').onclick = () => { const t = `🧠 SportingBrain Call It #${DAY}\n${marks.map(x => x ? '✅' : '❌').join('')}\nCan you call it? ${location.origin + BASE}call-it.html`;
        if (navigator.share) navigator.share({ title: 'SportingBrain: can you beat my score?', text: t }).catch(() => {}); else navigator.clipboard?.writeText(t); };
    }
    let revealed = false, locked = !!saved;
    document.addEventListener('click', e => { const b = e.target.closest('.ci-opt'); if (b && !locked) { picks[+b.dataset.q] = +b.dataset.o; renderCalls(); }
      if (e.target.id === 'ciLock') { locked = true; if (!practice) { const last = S.get('ci_last', 0); S.set('ci_streak', last === DAY ? S.get('ci_streak', 1) : last === DAY - 1 ? S.get('ci_streak', 0) + 1 : 1); S.set('ci_last', DAY); S.set(key, { picks, watched: false }); }
        renderCalls(); playOut(); document.getElementById('ciPlay').scrollIntoView({ behavior: 'smooth', block: 'start' }); } });
    renderCalls(); document.getElementById('ciChart').innerHTML = chartSVG([], false); if (saved) { if (saved.watched) { document.getElementById('ciChart').innerHTML = chartSVG(m.play, true); reveal(); } else playOut(); }
  </script>
</Base>
