---
import Base from '../layouts/Base.astro';
---
<Base title="Is It a Foul? The sports rules quiz | SportingBrain" description="Real rules scenarios from football, cricket, rugby, tennis, snooker, golf, netball and hockey. Fair or foul? Test your knowledge of the laws." page="foul">
  <header class="pg-head"><h1>Is It a Foul?</h1><p>Eighteen situations from eight sports. Ten per game, all under the current laws. Make the call, then read the ruling.</p></header>
  <div id="vs"></div>
  <section class="pg-card" id="game" aria-live="polite"></section>
  <p class="pg-note">Rulings follow the current laws of each game: IFAB for football, the MCC Laws of Cricket, World Rugby, the ITF, World Snooker, the R&amp;A, World Netball and FIH.</p>
  <script>
    import { FOULS } from '../data/games.js';
    import { shuffle, esc, markPlayed, challengeBox, showChallenge } from '../scripts/play.js';
    showChallenge(document.getElementById('vs'));
    const g = document.getElementById('game'); let Q, i, score;
    function start() { Q = shuffle(FOULS).slice(0, 10); i = 0; score = 0; show(); }
    function show() {
      const q = Q[i];
      g.innerHTML = `<p class="pg-step">${i + 1} of ${Q.length} · ${esc(q[0])}</p><p class="pg-q">${esc(q[1])}</p><div class="pg-opts"><button data-c="Fair">Fair</button><button data-c="Foul">Foul</button></div>`;
    }
    g.addEventListener('click', e => {
      const b = e.target.closest('[data-c]'); if (b && !b.disabled) { const q = Q[i], right = b.dataset.c === q[2]; if (right) score++;
        g.querySelectorAll('[data-c]').forEach(x => { x.disabled = true; if (x.dataset.c === q[2]) x.classList.add('ok'); else if (x === b) x.classList.add('no'); });
        g.insertAdjacentHTML('beforeend', `<p class="pg-fact"><b>${right ? 'Right.' : 'Not quite.'}</b> ${esc(q[3])}</p><div class="pg-btns"><button class="btn" data-n>${i + 1 < Q.length ? 'Next' : 'See my score'}</button></div>`); return; }
      if (e.target.closest('[data-n]')) { i++; if (i < Q.length) show(); else end(); }
      if (e.target.closest('[data-again]')) start();
    });
    function end() {
      markPlayed('is-it-a-foul');
      const line = score >= 9 ? 'Referee material.' : score >= 7 ? 'You know your laws.' : score >= 5 ? 'Decent. The rulebook is worth a read.' : 'The VAR would like a word.';
      g.innerHTML = `<p class="pg-step">Full time</p><div class="pg-score">${score}/${Q.length}</div><p>${line}</p><div class="pg-btns"><button class="btn ghost" data-again>Play again</button></div>`;
      g.appendChild(challengeBox(score, Q.length, 'Is It a Foul?'));
    }
    start();
  </script>
</Base>
