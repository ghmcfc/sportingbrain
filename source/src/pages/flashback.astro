---
import Base from '../layouts/Base.astro';
import { D } from '../data/content.js';
import { FLASHBACKS } from '../data/flashbacks.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const list = [...FLASHBACKS].sort((a, b) => ((a.date || a.when.match(/\d{4}/)[0]) > (b.date || b.when.match(/\d{4}/)[0]) ? 1 : -1));
---
<Base title="Flashback: the forgotten moments of sport | SportingBrain" description="The moments sport forgot, told properly: Dick, Kerr Ladies, the 1904 marathon, Jahangir Khan's 555, Major Taylor and more." wide>
  <div class="sec"><h2>Flashback</h2></div>
  <p class="teaser" style="max-width:60ch">Not the ones you already know. The moments sport forgot, told properly, with the numbers and the sources.</p>
  <div class="fb-strip" role="list">{list.map(f => <a role="listitem" href={`${base}flashback/${f.id}.html`}><b>{(f.date || f.when).match(/\d{4}/)[0]}</b><span>{f.sport}</span></a>)}</div>
  <div class="listgrid">{list.map(f => (
    <article class="card photo-card">
      {D.SB_PHOTO(f.sport, 800) && <img class="ph" src={D.SB_PHOTO(f.sport, 800)} alt="" loading="lazy" />}
      <div class="pc-body"><span class="tag" style={`background:${D.SB_SPORT_COLOURS[f.sport] || '#1F3864'}`}>{f.sport} · {f.when}</span>
        <div class="title">{f.title}</div><p class="teaser">{f.standfirst}</p></div>
      <a class="stretch" href={`${base}flashback/${f.id}.html`} aria-label={`Read: ${f.title}`}></a>
    </article>
  ))}</div>
</Base>
