---
import Base from '../layouts/Base.astro';
import { D } from '../data/content.js';
import { FLASHBACKS } from '../data/flashbacks.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const list = [...FLASHBACKS].sort((a, b) => ((a.date || a.when.match(/\d{4}/)[0]) > (b.date || b.when.match(/\d{4}/)[0]) ? 1 : -1));
import { photoFor } from '../scripts/photos.js';
const ph = f => photoFor(f.title + ' ' + f.standfirst + ' ' + (f.body || []).join(' '), f.sport, f.id.length, f.venue);
---
<Base title="Flashback: the forgotten moments of sport | SportingBrain" description="The moments sport forgot, told properly: Dick, Kerr Ladies, the 1904 marathon, Jahangir Khan's 555, Major Taylor and more." wide>
  <header class="art-head"><h1>Flashback</h1><p class="art-stand">Not the ones you already know. The moments sport forgot, told properly, with the numbers and the sources.</p></header>
  <div class="fb-strip" role="list">{list.map(f => <a role="listitem" href={`${base}flashback/${f.id}.html`}><b>{(f.date || f.when).match(/\d{4}/)[0]}</b><span>{f.sport}</span></a>)}</div>
  <div class="three tight">{list.map(f => { const p = ph(f); return (
    <a class="story" href={`${base}flashback/${f.id}.html`}>{p && <figure class="sfig"><img src={p.src} alt={p.alt} loading="lazy" width="800" height="450"><figcaption>{p.credit}</figcaption></figure>}<span class="kick">{f.sport} · {f.when}</span><h3>{f.title}</h3><p>{f.standfirst}</p></a>
  ); })}</div>
</Base>
